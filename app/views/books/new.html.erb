    <%= form.label :author %>
    <%= form.text_field :author %>
  </div>

  <div class="field">
    <%= form.label :coding_class_id, "Select Course" %>
    <% if @courses.present? %>
      <%= form.select :coding_class_id,
          options_from_collection_for_select(@courses, :id, :title, book.coding_class_id),
          { prompt: "Select Lesson" },
