<h1>Books</h1>
<%= form_with model: @book do |form| %>

    <div class="field">
    <%= form.label :title %>
    <%= form.text_field :title %><br>
  </div>

  <div class="field">
    <%= form.label :author %>
    <%= form.text_field :author %>

    <div class="field">
    <%= form.label :review %>
    <%= form.text_field :review %>

<div class="field">
    <%= form.label :comment %>
    <%= form.text_field :comment %>

  

    <div class="actions">
        <%= form.submit "Create Book" %>
      
        </div>
<% end %>